generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Guest {
  id         Int      @id @default(autoincrement())
  namaPic    String
  namaTravel String
  noHp       String
  kota       String
  alamat     String?  // Opsional
  status     String   // Leads, Prospek, Hot Prospek
  createdAt  DateTime @default(now())
}